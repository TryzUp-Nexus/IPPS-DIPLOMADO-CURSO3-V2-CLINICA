    {
      "name": "00 Preparar demo - crea identificadores",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/",
        "description": "HTTP esperado: 200"
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = Date.now().toString();",
              "pm.collectionVariables.set('demoSuffix', id);",
              "pm.collectionVariables.set('rutDemo', id.slice(-8) + '-K');",
              "pm.collectionVariables.set('rutDuplicado', id.slice(-8) + '-K');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },

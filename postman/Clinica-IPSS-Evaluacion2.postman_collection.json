        "description": "HTTP esperado: 201",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Dra. Andrea Rojas\",\n  \"especialidad\": \"Pediatría\",\n  \"email\": \"andrea.{{demoSuffix}}@example.com\",\n  \"password\": \"ClaveDemo123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const j=pm.response.json();",
              "pm.collectionVariables.set('medicoAId',j.medico._id);",
              "pm.collectionVariables.set('tokenA',j.token);",
              "pm.test('No expone password',()=>pm.expect(JSON.stringify(j.medico)).not.to.include('password'));"
            ]
          }
        }
